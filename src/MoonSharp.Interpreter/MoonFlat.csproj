<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MoonSharp.Interpreter</AssemblyName>
    <RootNamespace>MoonSharp.Interpreter</RootNamespace>
    <Version>0.1.0-alpha.1</Version>
    <PackageId>MoonFlat</PackageId>
    <Authors>MoonFlat contributors</Authors>
    <Description>A MoonSharp-derived Lua scripting library for .NET with a MoonSharp-compatible API, CLR interop, compact table storage, configurable VM stacks, and generalized iteration.</Description>
    <PackageTags>lua;dotnet;csharp;interpreter;scripting;moonsharp;luau;clr;netstandard</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <DefineConstants>$(DefineConstants);DOTNET_CORE;NETFX_CORE</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>1591;1570;1572;3021</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties/AssemblyInfo.cs" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
